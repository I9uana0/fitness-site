// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Модель пользователя
model User {
  id            String         @id @default(uuid())
  email         String         @unique
  phone         String         @unique
  dateOfBirth   DateTime
  password      String // Хранится хэшированный пароль
  name          String         @db.VarChar(255) // Имя пользователя
  surname       String         @db.VarChar(255) // Фамилия пользователя
  subscriptions Subscription[] // Связь с абонементами пользователя

  createdAt DateTime @default(now())
}

// Модель типа абонемента (Standard, Premium Unlimited)
model SubscriptionType {
  id            String         @id @default(uuid())
  name          String         @unique @db.VarChar(255)
  priceAmount   Int // Цена в копейках/центах для избежания проблем с плавающей точкой
  description   String?        @db.Text
  rate          Rate           @default(STANDARD)
  subscriptions Subscription[] // Связь с активными абонементами этого типа
}

// Модель абонемента пользователя
model Subscription {
  id                 String             @id @default(uuid())
  userId             String // ID пользователя, которому принадлежит абонемент
  user               User               @relation(fields: [userId], references: [id])
  subscriptionTypeId String // ID типа абонемента
  subscriptionType   SubscriptionType   @relation(fields: [subscriptionTypeId], references: [id])
  startDate          DateTime           @default(now())
  endDate            DateTime
  pricePaid          Int // Фактическая цена, уплаченная за этот абонемент
  status             SubscriptionStatus @default(ACTIVE)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

// Расписание занятий
model ScheduleItem {
  id              String    @id @default(uuid())
  name            String    @db.VarChar(255)
  coach           String    @db.VarChar(255)
  time            String    @db.VarChar(5) // Например, "08:00"
  durationMinutes Int
  type            String    @db.VarChar(50) // Например, "Hard", "Light", "Fun"
  dayOfWeek       DayOfWeek // День недели для занятия
}

// Перечисление для статуса абонемента
enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
}

// Перечисление для дня недели
enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum Rate {
  STANDARD
  PREMIUM
}
